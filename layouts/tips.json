{
    "tips_content": {
        "type": "array",
        "orientation": "horizontal",
        "v_alignment": "top",
        "h_alignment": "left",
        "margin": "8,8,8,8",
        "content": [
            {
                "type": "array",
                "orientation": "vertical",
                "v_alignment": "top",
                "h_alignment": "left",
                "max_width": 330,
                "content": [
                    {
                        "type": "group",
                        "header": "What Your Goal Needs",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Every goal except Critterpedia Hunt sits behind the"
                                },
                                {
                                    "type": "text",
                                    "text": "Project K gate:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Net 1, Rod 1, Axe 1, Vaulting Pole, Ladder,"
                                },
                                {
                                    "type": "text",
                                    "text": "  Villager 6."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "On top of that:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Critterpedia Hunt  nothing - it sits in the starting"
                                },
                                {
                                    "type": "text",
                                    "text": "                     region. By far the shortest goal."
                                },
                                {
                                    "type": "text",
                                    "text": "  Credits            nothing more"
                                },
                                {
                                    "type": "text",
                                    "text": "  Museum (No Art)    Net 2, Rod 2, Shovel 1, Can 1,"
                                },
                                {
                                    "type": "text",
                                    "text": "                     Wet Suit, ALL 12 Month items"
                                },
                                {
                                    "type": "text",
                                    "text": "  Museum (Art)       the above plus Redd"
                                },
                                {
                                    "type": "text",
                                    "text": "  All Home Loans     Net 2, Rod 2, Shovel 2, Axe 2,"
                                },
                                {
                                    "type": "text",
                                    "text": "                     Can 2, Villager 8, Inventory 2,"
                                },
                                {
                                    "type": "text",
                                    "text": "                     Nook Miles Ticket, Tool Ring,"
                                },
                                {
                                    "type": "text",
                                    "text": "                     Wet Suit, Leif, C.J., Flick,"
                                },
                                {
                                    "type": "text",
                                    "text": "                     Daisy Mae, Be a Chef DIY Recipes+"
                                }
                            ]
                        }
                    }
                ]
            },
            {
                "type": "array",
                "orientation": "vertical",
                "v_alignment": "top",
                "h_alignment": "left",
                "max_width": 330,
                "content": [
                    {
                        "type": "group",
                        "header": "Check Tricks: Leif & Birthday",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Leif:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Buy from Leif on 3 SEPARATE visits, not 3 purchases"
                                },
                                {
                                    "type": "text",
                                    "text": "  in one visit."
                                },
                                {
                                    "type": "text",
                                    "text": "  He is the ONLY route to Craft Hedge."
                                },
                                {
                                    "type": "text",
                                    "text": "  He also appears in Craft Veggie Basket, Shrubbery"
                                },
                                {
                                    "type": "text",
                                    "text": "  Hubbubbery, Sprout Out Loud, Executive Producer and"
                                },
                                {
                                    "type": "text",
                                    "text": "  the All Home Loans goal."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Birthday:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Happy Birthday! now has NO logic requirement - the"
                                },
                                {
                                    "type": "text",
                                    "text": "  birth_month option tells the apworld when your"
                                },
                                {
                                    "type": "text",
                                    "text": "  birthday is. Set your in-game birthday to match."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Spooky Carriage:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Now just October + Shovel. Leif and November are no"
                                },
                                {
                                    "type": "text",
                                    "text": "  longer part of it."
                                }
                            ]
                        }
                    },
                    {
                        "type": "group",
                        "header": "Do Not Chase These",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Gates nothing anywhere in the logic:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Saharah, Kicks, Label, Bell Voucher."
                                },
                                {
                                    "type": "text",
                                    "text": "  These are correctly NOT marked progression."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Critterpedia Entry is marked progression but gates"
                                },
                                {
                                    "type": "text",
                                    "text": "nothing. You collect them from the Critterpedia Hunt"
                                },
                                {
                                    "type": "text",
                                    "text": "checks; nothing in the logic counts them."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Everything else now gates something. Tool Ring,"
                                },
                                {
                                    "type": "text",
                                    "text": "Inventory Space, the permits and the cooking books"
                                },
                                {
                                    "type": "text",
                                    "text": "all matter for All Home Loans."
                                }
                            ]
                        }
                    }
                ]
            },
            {
                "type": "array",
                "orientation": "vertical",
                "v_alignment": "top",
                "h_alignment": "left",
                "max_width": 330,
                "content": [
                    {
                        "type": "group",
                        "header": "Check Tricks: Halloween & Bamboo",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Spooky Carriage DIY:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Give Jack 2 lollipops on Halloween."
                                },
                                {
                                    "type": "text",
                                    "text": "  Wear the FULL Jack costume to scare villagers into"
                                },
                                {
                                    "type": "text",
                                    "text": "  handing you candy. Do NOT wear the full outfit when"
                                },
                                {
                                    "type": "text",
                                    "text": "  you want to give candy out."
                                },
                                {
                                    "type": "text",
                                    "text": "  Logic also wants October + Shovel, and either"
                                },
                                {
                                    "type": "text",
                                    "text": "  November or Leif."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Bamboo:"
                                },
                                {
                                    "type": "text",
                                    "text": "  Needed for BOTH the Bamboo Noodle Slide and"
                                },
                                {
                                    "type": "text",
                                    "text": "  The Hearth."
                                },
                                {
                                    "type": "text",
                                    "text": "  Daisy Mae gives bamboo shoots once you have bought"
                                },
                                {
                                    "type": "text",
                                    "text": "  turnips from her on 3 SEPARATE visits - not 3 lots"
                                },
                                {
                                    "type": "text",
                                    "text": "  in one go. That is the cheap route."
                                },
                                {
                                    "type": "text",
                                    "text": "  Otherwise use a Nook Miles Ticket, or Kapp'n if your"
                                },
                                {
                                    "type": "text",
                                    "text": "  goal is post-credits and you have neither."
                                }
                            ]
                        }
                    },
                    {
                        "type": "group",
                        "header": "Reading This Tracker",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Green means in logic - you have what the rules require."
                                },
                                {
                                    "type": "text",
                                    "text": "Locations your YAML removed are hidden entirely, so the"
                                },
                                {
                                    "type": "text",
                                    "text": "map shows only checks that exist in your slot."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Before connecting, season gates are treated as open and"
                                },
                                {
                                    "type": "text",
                                    "text": "everything is shown. Connect for the real picture."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Progressive Villager matters at every single stage,"
                                },
                                {
                                    "type": "text",
                                    "text": "1 through 8 - unlike most progressives there is no"
                                },
                                {
                                    "type": "text",
                                    "text": "dead copy. 3 opens a region, 6 opens Project K,"
                                },
                                {
                                    "type": "text",
                                    "text": "8 is needed for All Home Loans."
                                }
                            ]
                        }
                    }
                ]
            },
            {
                "type": "array",
                "orientation": "vertical",
                "v_alignment": "top",
                "h_alignment": "left",
                "max_width": 330,
                "content": [
                    {
                        "type": "group",
                        "header": "Sending Checks",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Checks are only sent from the Manual client. Clicking a"
                                },
                                {
                                    "type": "text",
                                    "text": "location here in PopTracker sends nothing - this tracker"
                                },
                                {
                                    "type": "text",
                                    "text": "mirrors Archipelago, it never writes back to it."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "The client lists Archipelago's location NAMES; the tracker"
                                },
                                {
                                    "type": "text",
                                    "text": "shows the in-game descriptions. They are not the same."
                                },
                                {
                                    "type": "text",
                                    "text": "Tracker: \"Catch 10 fish\"  ->  AP: \"Angling for Perfection!\""
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "/send <AP name> works and fuzzy-matches, but it matches"
                                },
                                {
                                    "type": "text",
                                    "text": "names only - never the descriptions. Clicking the button"
                                },
                                {
                                    "type": "text",
                                    "text": "in the client avoids the whole problem."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "The client lists REMAINING locations; buttons vanish once"
                                },
                                {
                                    "type": "text",
                                    "text": "sent. A shrinking list is normal, not a bug."
                                }
                            ]
                        }
                    },
                    {
                        "type": "group",
                        "header": "The Honour System",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Nothing stops you using an item you have not received."
                                },
                                {
                                    "type": "text",
                                    "text": "The whole randomizer rests on you not doing that."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Tools: CRAFTING one is a check; USING one needs the item."
                                },
                                {
                                    "type": "text",
                                    "text": "Months: seasonal activities wait for that Month item."
                                },
                                {
                                    "type": "text",
                                    "text": "NPCs are items - Leif, Redd, C.J., Flick, Gulliver, Wisp,"
                                },
                                {
                                    "type": "text",
                                    "text": "Daisy Mae, Saharah, Kicks, Label, Celeste."
                                },
                                {
                                    "type": "text",
                                    "text": "Traps are self-applied: when one lands, go perform it."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Sending a check the game handed you early is fine - AP"
                                },
                                {
                                    "type": "text",
                                    "text": "does not validate it. USING an item early is what breaks"
                                },
                                {
                                    "type": "text",
                                    "text": "the run. If in doubt, send the check, hold the item."
                                }
                            ]
                        }
                    }
                ]
            },
            {
                "type": "array",
                "orientation": "vertical",
                "v_alignment": "top",
                "h_alignment": "left",
                "max_width": 330,
                "content": [
                    {
                        "type": "group",
                        "header": "Before You Start",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Pick the hemisphere your YAML says. It is PERMANENT and"
                                },
                                {
                                    "type": "text",
                                    "text": "roughly half the logic branches on it."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "start_month may put you in a random month, not January."
                                },
                                {
                                    "type": "text",
                                    "text": "Month - January is now an item like any other."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "birth_month tells the apworld your birthday, so set"
                                },
                                {
                                    "type": "text",
                                    "text": "your in-game birthday to match it."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "starting_tools may hand you a rod and/or net up front."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "One island per Switch console, shared by all users on it."
                                },
                                {
                                    "type": "text",
                                    "text": "A fresh island means deleting the old one - irreversible"
                                },
                                {
                                    "type": "text",
                                    "text": "without an island backup. Be sure before you commit."
                                }
                            ]
                        }
                    },
                    {
                        "type": "group",
                        "header": "Time Travel",
                        "content": {
                            "type": "array",
                            "orientation": "vertical",
                            "content": [
                                {
                                    "type": "text",
                                    "text": "Time travel is the usual way to reach seasonal checks,"
                                },
                                {
                                    "type": "text",
                                    "text": "but only into months you HAVE the Month item for."
                                },
                                {
                                    "type": "text",
                                    "text": "Anything else is an out-of-logic check."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Jumping forward past a Sunday rots held turnips."
                                },
                                {
                                    "type": "text",
                                    "text": "Clear your stock before a long jump."
                                },
                                {
                                    "type": "text",
                                    "text": ""
                                },
                                {
                                    "type": "text",
                                    "text": "Bamboo is NOT seasonal - the trees are there all year."
                                },
                                {
                                    "type": "text",
                                    "text": "Only Young Spring Bamboo needs spring."
                                },
                                {
                                    "type": "text",
                                    "text": "To reach bamboo you need Daisy Mae or a Nook Miles"
                                },
                                {
                                    "type": "text",
                                    "text": "Ticket. Kapp'n only matters if your goal is post-"
                                },
                                {
                                    "type": "text",
                                    "text": "credits and you have neither."
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    }
}
